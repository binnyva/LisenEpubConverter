  "description": "Shared voice catalogue: OpenAI built-in speech voices and Fish Audio default voices.",
  "scope": {
    "providers": [
      "openai",
      "fish"
    ],
    "voiceCount": 20,
    "modelCount": 7,
    "includesCustomVoices": false,
    "includesCommunityVoices": false
  },
  "integration": {
    "status": "listing-and-bindings-supported",
    "notes": "The library loader and voices apply stage support this version, including Fish bindings and unknown limits. Fish synthesis and version-2 catalogue refresh/import are not implemented."
  },
  "conventions": {
    "identity": "Voice IDs are provider-qualified and independent of backend models; nativeVoiceId is the API value. models references model record IDs.",
    "unknown": "Unknown scalar traits use 'unknown'; empty trait arrays mean no verified values. A null limit means unknown, never unlimited.",
    "language": "Voice traits describe published voice languages. Model language sets describe synthesis coverage; neither guarantees an accent.",
    "instructions": "supportsInstructions means a separate instructions field. Fish delivery cues are embedded in text and require adapter translation.",
    "provenance": "Bundled means manually curated from the cited provider pages. No automatic refresh or authenticated catalogue discovery was run.",
    "availability": "Listed means present in public provider documentation or the default catalogue at refreshedAt, not verified account access or a successful synthesis request.",
    "annotations": "Reserved for user annotations; preserve separately when refreshing provider metadata."
  },
  "notes": [
    "OpenAI voice presentation, age, accent, and tone are not specified in the reviewed official guide, so they remain unknown.",
    "Only named OpenAI TTS model aliases are catalogued; dated snapshots and Realtime voices are outside this initial manifest.",
    "Fish default membership was checked on the rendered default-voices page; all seven profiles are published by Fish Official.",
    "Fish sample media URLs are signed and expire after one hour. Stable profile preview links are retained instead.",
    "Fish's total request text limit was not established. The documented chunk_length range of 100–300 is a processing option, not a request-length limit.",
    "Fish reference-ID compatibility is inferred from the shared API contract and is explicitly marked on each voice.",
    "Hannah's profile says conversation specialist; the default list says conversion specialist. The profile description is used here.",
    "Catalogue creation made no synthesis requests."
  ],
